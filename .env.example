# ==========================================
# 环境变量模板
# ==========================================
#   cp .env.example .env  然后填上真实值。
#
#   .env 已被 .gitignore 忽略，**不要提交**。
#   .env.example 是模板，会进版本库 —— 里面只能放占位值，不能放真实口令。
#
#   配置文件（application*.yml）里不写任何默认值：
#   缺了这些变量时，prod 直接拒绝启动，非 prod 用 application-dev.yml 的本地兜底值。
#
#   优先级：真实 OS 环境变量 > .env 文件 > application.yml
#
#   .env 是被 Spring Boot 的 spring.config.import 按 **properties 格式**读的：
#   · 值里含 # 会被当成注释起始，必要时用引号包起来（DB_PASSWORD="pa#ss"）
#   · 值里含空格也要加引号


# ==========================================
# 数据库
# ==========================================
# R2DBC 连接串。容器内把 localhost 换成 mysql（见 docker-compose.yml）。
DB_URL=r2dbc:mysql://localhost:3306/ryu_blog_webflux?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=

# ==========================================
# Redis
# ==========================================
# spring.data.redis 与 sa-token.alone-redis 用的是**同一组**变量。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ==========================================
# JWT
# ==========================================
# Sa-Token 的 JWT 签名密钥。
#   必须 >= 32 字节，prod 下不足会拒绝启动；
#   为空则直接拒绝启动（任何环境）——
#   空密钥时 Sa-Token 会回退到内置的公开默认密钥，
#   任何人都能签发任意 userId 的合法 token 冒充 admin。
# 生成：openssl rand -base64 48
JWT_SECRET=

# ==========================================
# 服务
# ==========================================
# 激活的 profile。prod 下缺必需变量会拒绝启动。
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=5300

# ==========================================
# 文件上传
# ==========================================
UPLOAD_PATH=./uploads

# ==========================================
# AI
# ==========================================
# AI 总开关与并发闸门。
BLOG_AI_ENABLED=true
BLOG_AI_MAX_CONCURRENT=8

# AI 提供商的 API Key（按实际使用的提供商填写）。
# 注意：真实配置优先取数据库 t_sys_config 的 ai.provider.* —— 这里只是给
# Spring AI 自动配置占位用（AI 关掉时也能正常启动）。
# OpenAI
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_BASE_URL=https://api.openai.com
# DeepSeek
# DEEPSEEK_API_KEY=your-deepseek-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key
# Azure OpenAI
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# ==========================================
# Docker Compose（只在用 docker compose 时需要）
# ==========================================
# MySQL root 口令 —— compose 里用 :? 强制必填，不设置会直接退出。
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=ryu_blog
MYSQL_USERNAME=root
# 宿主机端口映射
MYSQL_PORT=3306
API_PORT=5300
WEB_PORT=80
