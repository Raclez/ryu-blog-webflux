# 项目排除路径
/target/

# 配置文件
.env
.env.*
!.env.example
/config.env
/config-local.env
/config-prod.env

# 日志
/logs/
*.log

# IDE
/.idea/
/*.iml
/.cursor/

# OS
.DS_Store
Thumbs.db

# 数据库
# jqwik 的属性测试库是**文件**，不是目录 —— 带斜杠的规则匹配不到它
/.jqwik-database

# 构建产物
*.class
*.jar
*.war

# Claude Code 本地设置（只与本机有关，不进仓库）
/.claude/settings.local.json

# Playwright MCP 本地产物（截图/trace，不进仓库）
/.playwright-mcp/

# 内部文档：公开仓库只保留 README，其余留在本地磁盘
/REVIEW.md
/API.md
/RBAC.md
/CLAUDE.md
/docs/

# 一次性本地脚本
/tools/
